# 服务器部署环境变量配置
# 复制此文件为 .env 并填入实际值

# Google API 密钥（必需）
GOOGLE_API_KEY="your_google_api_key_here"

# 应用端口配置
FRONTEND_PORT=3002
BACKEND_PORT=8002

# 生产环境配置
NODE_ENV=production

# 前端后端通信配置（重要：服务器部署时必须配置）
# 开发环境使用 localhost
NEXT_PUBLIC_BACKEND_URL=http://localhost:8002

# 生产环境使用实际域名（取消注释并修改为您的域名）
# NEXT_PUBLIC_BACKEND_URL=https://your-domain.com
