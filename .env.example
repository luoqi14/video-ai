# Video AI 项目环境变量模板
# 复制此文件为 .env 并填入实际值

# Google API 密钥（必需）
# 获取地址：https://ai.google.dev/
GOOGLE_API_KEY="your_google_api_key_here"

# 应用端口配置
FRONTEND_PORT=3002
BACKEND_PORT=8002

# 生产环境配置
NODE_ENV=production

# 前端后端通信配置
# 开发环境
NEXT_PUBLIC_BACKEND_URL=http://localhost:8002
# 生产环境（取消注释并修改为您的域名）
# NEXT_PUBLIC_BACKEND_URL=https://your-domain.com
